<!DOCTYPE html>
<html lang="ca">
<head>
  {{> header}}
  <title>Batallas-Civilization(MNR)</title>
</head>
<body>
  {{> menu}}

  <main class="container">
    <h1>Civilization (MNR)</h1>
    <h2>Logs de batalla</h2>

    <p>Información actualitzada de la base de datos</p>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>ID Civilizacion</th>
            <th>Nombre</th>
            <th>ID Batalla</th>
            <th>Madera Conseguida</th>
            <th>Hierro Conseguido</th>
            <th>ID Civ Enemiga</th>
            <th>Log</th>
          </tr>
        </thead>

        <tbody>
          {{#each batallas}}
            <tr>
              <td>{{ID_Civ}}</td>
              <td>{{Nombre}}</td>
              <td>{{ID_Bat}}</td>
              <td>{{Madera_conseguida}}</td>
              <td>{{Hierro_conseguido}}</td>
              <td>{{ID_Civ_Enem}}</td>
              <td>{{Log}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>  
    <br>
    <a class="volver" href="/batallas">Volver a la pantalla anterior</a>

  </main>

  {{> footer}}
</body>
</html>